# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string. On Railway use the reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/savethesoul?schema=public"

# ── Encryption at rest ─────────────────────────────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Rotating this key makes existing encrypted fields unreadable (see docs/PRIVACY_AND_CONSENT.md).
DATA_ENCRYPTION_KEY=""

# ── Demo mode ──────────────────────────────────────────────
# "true" shows one-click synthetic demo accounts on the sign-in page and enables
# simulated workflows. Demo accounts can never be created by clients.
DEMO_MODE="true"

# ── AI provider ────────────────────────────────────────────
# auto      → OpenAI if OPENAI_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY is set,
#             otherwise the offline demo companion
# openai    → OpenAI Responses API (falls back to a labelled safe message on error)
# anthropic → Anthropic Messages API (same fallback behaviour)
# demo      → deterministic offline companion (no network, clearly labelled)
LLM_PROVIDER="auto"
# Model for the selected provider. Unset = provider default (openai: gpt-5.4-mini,
# anthropic: claude-opus-5-5).
LLM_MODEL=""
LLM_TIMEOUT_MS="30000"
# Use a project-scoped key with a monthly budget limit. Never commit real values.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
