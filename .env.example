# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string. On Railway use the reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/savethesoul?schema=public"

# ── Encryption at rest ─────────────────────────────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Rotating this key makes existing encrypted fields unreadable (see docs/PRIVACY_AND_CONSENT.md).
DATA_ENCRYPTION_KEY=""

# ── Demo mode ──────────────────────────────────────────────
# "true" shows one-click synthetic demo accounts on the sign-in page and enables the
# labelled simulated workflows (alerts, acknowledgements). It does NOT choose the AI:
# with a valid OPENAI_API_KEY the companion uses the real model even in demo mode.
DEMO_MODE="true"

# ── AI provider ────────────────────────────────────────────
# openai    → OpenAI Responses API (primary). Without OPENAI_API_KEY the app uses the
#             labelled offline demo companion and /api/health reports "missing_key".
#             An explicit "openai" never routes to Anthropic.
# demo      → deterministic offline companion (no network, clearly labelled)
# anthropic → optional alternative adapter (needs ANTHROPIC_API_KEY)
# auto      → OpenAI if its key is set, else Anthropic if its key is set, else demo
LLM_PROVIDER="openai"
# Model for the selected provider (unset = openai: gpt-5.4-mini). Confirm availability
# for your key with: pnpm ai:live-check --models
LLM_MODEL="gpt-5.4-mini"
LLM_TIMEOUT_MS="30000"
# Project-scoped key with a monthly budget limit. Set it yourself; never commit it.
OPENAI_API_KEY=""

# ── Voice Mode (Sakina, push-to-talk) ──────────────────────
# Uses the same OPENAI_API_KEY. Unavailable (text chat only) without it or with LLM_PROVIDER=demo.
VOICE_STT_MODEL="gpt-4o-mini-transcribe"   # speech-to-text; "gpt-transcribe" also tested
VOICE_TTS_MODEL="gpt-4o-mini-tts"          # text-to-speech
VOICE_TTS_VOICE="marin"
VOICE_LANGUAGE="en"                        # English first; Arabic ("ar") is the planned next step
VOICE_TIMEOUT_MS="30000"
